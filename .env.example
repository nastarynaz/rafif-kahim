# Server only. Never prefix secrets with NEXT_PUBLIC_.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
# Generate locally: openssl rand -hex 32
RATE_LIMIT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Privacy notice: set this to the people actually authorized to read feedback.
FEEDBACK_READERS=Rafif dan admin aspirasi yang diberi wewenang
# Optional protected retention job. Generate with openssl rand -hex 32.
CRON_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
